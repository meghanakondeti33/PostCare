# Environment Configuration
ENV=production

# Database & Cache
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=rediss://default:password@host:port

# Security & CORS
JWT_SECRET=your-production-jwt-secret-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,https://postcare.vercel.app
PUBLIC_BASE_URL=https://your-render-backend.onrender.com

# AI Provider Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_TO_MOCK=false
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
EMBEDDING_PROVIDER=mock

# Clinical Safety & Outbound Policy
CONSENSUS_POLICY=STRICT_CONSERVATIVE
DEFAULT_HOSPITAL_CAPACITY=10
