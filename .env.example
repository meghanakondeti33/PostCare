# Environment Configuration Example
ENV=development

# Database Configuration (PostgreSQL in production, SQLite in local test mode)
DATABASE_URL=sqlite+aiosqlite:///./postcare.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/postcare

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Secret
#JWT_SECRET=super-secret-key-change-in-production-healthcare-2026

# AI Provider Configuration ("mock", "gemini", "openai")
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Clinical Safety Policy ("STRICT_CONSERVATIVE", "MAJORITY_VOTE", "RULE_OVERRIDE_ONLY")
CONSENSUS_POLICY=STRICT_CONSERVATIVE
